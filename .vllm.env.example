# 複製成 .vllm.env 並填入你自己的端點（.vllm.env 已被 .gitignore 擋住，請勿提交）
# OpenAI 相容的 vLLM 端點（含 /v1）與模型名稱
VLLM_URL=https://your-vllm-host.example.com/v1
VLLM_MODEL=your-org/your-model
# VLLM_KEY=              # 端點需要金鑰時才填
# 每手總思考時間上限（秒）由 arena.THINK_LIMIT_SECS 控制，預設 40，可用環境變數 DDZ_THINK_LIMIT 覆寫
# VLLM_THINK=0           # 0 直覺模式（預設，關閉思考）；1 思考模式（預算 = 上限 − 5 秒）
VLLM_THINK=0
